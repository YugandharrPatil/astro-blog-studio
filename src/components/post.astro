---
const { post } = Astro.props as {
	post: PostType;
};
import type { PostType } from "@/types";
import { Card, CardContent } from "./ui/card";

const isPublished = post.filePath?.startsWith("src/content/blog/published");
---

<a href={`/blog/${post.data.slug}/`}>
	<Card className="hover:shadow-lg transition-all my-4">
		<CardContent>
			<h1 class="text-xl font-bold">{post.data.title}</h1>
			<h2 class="text-md text-muted-foreground">{post.data.subtitle}</h2>
			<div class="flex gap-2">
				{post.data.tags?.map((tag: string) => <span class="text-sm text-muted-foreground">{tag}</span>)}
			</div>
			<small class={isPublished ? "bg-green-500" : "bg-yellow-500"}>{isPublished ? "published" : "draft"}</small>
		</CardContent>
		<!-- {JSON.stringify(post)} -->
	</Card>
</a>
